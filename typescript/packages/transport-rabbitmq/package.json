{
  "name": "@vsaga/transport-rabbitmq",
  "version": "0.1.0",
  "description": "amqplib-backed vSaga MessageTransport, wire-compatible with VSaga.Transport.RabbitMQ.",
  "license": "MIT",
  "author": "Rafael Camara",
  "homepage": "https://github.com/RafaelJCamara/vSaga/tree/main/typescript/packages/transport-rabbitmq#readme",
  "bugs": {
    "url": "https://github.com/RafaelJCamara/vSaga/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RafaelJCamara/vSaga.git",
    "directory": "typescript/packages/transport-rabbitmq"
  },
  "keywords": [
    "vsaga",
    "saga",
    "message-transport",
    "rabbitmq",
    "amqp"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@vsaga/protocol": "0.1.0",
    "amqplib": "^0.10.9"
  },
  "devDependencies": {
    "@testcontainers/rabbitmq": "^12.1.0",
    "@types/amqplib": "^0.10.7",
    "testcontainers": "^12.1.0"
  }
}
