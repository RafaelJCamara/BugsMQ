{
  "name": "@vsaga/transport-rabbitmq",
  "version": "0.1.0",
  "description": "amqplib-backed vSaga MessageTransport, wire-compatible with VSaga.Transport.RabbitMQ.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@vsaga/protocol": "0.1.0",
    "amqplib": "^0.10.9"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.7"
  }
}
