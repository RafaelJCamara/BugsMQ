{
  "name": "@vsaga/fastify",
  "version": "0.1.0",
  "description": "Registers @vsaga/transport-http's inbound receive endpoint as a Fastify plugin.",
  "license": "MIT",
  "author": "Rafael Camara",
  "homepage": "https://github.com/RafaelJCamara/vSaga/tree/main/typescript/packages/fastify#readme",
  "bugs": {
    "url": "https://github.com/RafaelJCamara/vSaga/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RafaelJCamara/vSaga.git",
    "directory": "typescript/packages/fastify"
  },
  "keywords": [
    "vsaga",
    "saga",
    "fastify",
    "http"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@vsaga/transport-http": "0.1.0"
  },
  "peerDependencies": {
    "fastify": "^4.28.0 || ^5.0.0"
  },
  "devDependencies": {
    "fastify": "^5.6.1"
  }
}
