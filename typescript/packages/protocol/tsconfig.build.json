// tsup's .d.ts pass builds a synthetic program that cannot use a `composite` project (TS6307).
// The composite flag exists for `tsc -b` project references (the `typecheck` script), so keep it in
// tsconfig.json and hand tsup this non-composite view of the same sources.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "declarationMap": false
  },
  "include": ["src/**/*.ts"]
}
