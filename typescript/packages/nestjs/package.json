{
  "name": "@vsaga/nestjs",
  "version": "0.1.0",
  "description": "A NestJS dynamic module mounting @vsaga/transport-http's inbound receive endpoint on a Nest (Express platform) app.",
  "license": "MIT",
  "author": "Rafael Camara",
  "homepage": "https://github.com/RafaelJCamara/vSaga/tree/main/typescript/packages/nestjs#readme",
  "bugs": {
    "url": "https://github.com/RafaelJCamara/vSaga/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RafaelJCamara/vSaga.git",
    "directory": "typescript/packages/nestjs"
  },
  "keywords": [
    "vsaga",
    "saga",
    "nestjs",
    "http"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@vsaga/transport-http": "0.1.0"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0",
    "reflect-metadata": "^0.1.13 || ^0.2.0",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/testing": "^11.1.6",
    "@types/express": "^5.0.5",
    "express": "^5.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  }
}
