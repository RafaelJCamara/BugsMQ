{
  "name": "@vsaga/participant",
  "version": "0.1.0",
  "description": "Framework-agnostic vSaga participant runtime: dispatch, dedupe, reply-with-causation, topology reporting.",
  "license": "MIT",
  "author": "Rafael Camara",
  "homepage": "https://github.com/RafaelJCamara/vSaga/tree/main/typescript/packages/participant#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RafaelJCamara/vSaga.git",
    "directory": "typescript/packages/participant"
  },
  "keywords": [
    "vsaga",
    "saga",
    "saga-orchestration",
    "distributed-transactions",
    "participant"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@vsaga/protocol": "0.1.0"
  }
}
