{
  "name": "@vsaga/transport-http",
  "version": "0.1.0",
  "description": "Brokerless vSaga MessageTransport over plain HTTP, wire-compatible with VSaga.Transport.Http.",
  "license": "MIT",
  "author": "Rafael Camara",
  "homepage": "https://github.com/RafaelJCamara/vSaga/tree/main/typescript/packages/transport-http#readme",
  "bugs": {
    "url": "https://github.com/RafaelJCamara/vSaga/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RafaelJCamara/vSaga.git",
    "directory": "typescript/packages/transport-http"
  },
  "keywords": [
    "vsaga",
    "saga",
    "message-transport",
    "http"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "postbuild": "node ../../scripts/prepend-node-types-reference.mjs",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@vsaga/protocol": "0.1.0",
    "@types/node": "^22.19.0"
  }
}
