{
  "name": "@vsaga/express",
  "version": "0.1.0",
  "description": "Mounts @vsaga/transport-http's inbound receive endpoint on an Express app or Router.",
  "license": "MIT",
  "author": "Rafael Camara",
  "homepage": "https://github.com/RafaelJCamara/vSaga/tree/main/typescript/packages/express#readme",
  "bugs": {
    "url": "https://github.com/RafaelJCamara/vSaga/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RafaelJCamara/vSaga.git",
    "directory": "typescript/packages/express"
  },
  "keywords": [
    "vsaga",
    "saga",
    "express",
    "http"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@vsaga/transport-http": "0.1.0",
    "@types/express": "^5.0.5"
  },
  "peerDependencies": {
    "express": "^4.19.0 || ^5.0.0"
  },
  "devDependencies": {
    "express": "^5.1.0"
  }
}
