{
  "name": "@vsaga/express",
  "version": "0.1.0",
  "description": "Mounts @vsaga/transport-http's inbound receive endpoint on an Express app or Router.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@vsaga/transport-http": "0.1.0"
  },
  "peerDependencies": {
    "express": "^4.19.0 || ^5.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "express": "^5.1.0"
  }
}
