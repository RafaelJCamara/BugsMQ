<Project Sdk="Microsoft.NET.Sdk">

  <!-- Package-specific description for nuget.org search results, overriding Directory.Build.props's
       shared fallback (MSBuild evaluates that file first, so this later value wins). -->
  <PropertyGroup>
    <Description>RabbitMQ.Client-based IMessageTransport for vSaga -- the default broker transport, with no MassTransit or Wolverine dependency required.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\VSaga.Abstractions\VSaga.Abstractions.csproj" />
    <ProjectReference Include="..\VSaga.Transport.Common\VSaga.Transport.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="RabbitMQ.Client" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
