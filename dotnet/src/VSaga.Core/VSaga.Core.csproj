<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- .CallHttp (docs/http-based-sagas.md §5.2/§5.3) needs ISagaContextLogSink to write its own
         request/reply timeline entries, the same reason VSaga.Dashboard.Api.Tests gets this for
         SagaChangePollingService. -->
    <InternalsVisibleTo Include="VSaga.Http" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VSaga.Abstractions\VSaga.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
