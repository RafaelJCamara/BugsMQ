<Project Sdk="Microsoft.NET.Sdk">

  <!-- Package-specific description for nuget.org search results, overriding Directory.Build.props's
       shared fallback (MSBuild evaluates that file first, so this later value wins). -->
  <PropertyGroup>
    <Description>Brighter adapter for vSaga's IMessageTransport -- run vSaga sagas over an existing Brighter-based messaging setup.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\VSaga.Abstractions\VSaga.Abstractions.csproj" />
    <ProjectReference Include="..\VSaga.Transport.Common\VSaga.Transport.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <!-- Version bounded in Directory.Packages.props, alongside the other two bus SDK pins. -->
    <PackageReference Include="Paramore.Brighter" />
    <PackageReference Include="Paramore.Brighter.MessagingGateway.RMQ.Async" />
    <!-- Referenced directly (not just pulled in transitively via the gateway package above) because
         SendWithConfirmationAsync below catches RabbitMQ.Client.Exceptions.PublishException itself,
         the exception type RabbitMQ.Client 7.2.2's own publisher-confirmation tracking throws for a
         genuine broker-side nack, one layer below Paramore.Brighter's own abstractions. Same reasoning
         as VSaga.Transport.RabbitMQ's identical direct reference. -->
    <PackageReference Include="RabbitMQ.Client" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
