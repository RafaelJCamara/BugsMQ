<Project Sdk="Microsoft.NET.Sdk">

  <!-- Package-specific description for nuget.org search results, overriding Directory.Build.props's
       shared fallback (MSBuild evaluates that file first, so this later value wins). -->
  <PropertyGroup>
    <Description>Brokerless HTTP transport for vSaga -- run sagas and participants over plain HTTP instead of a message broker.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- MapVSagaHttp() needs IEndpointRouteBuilder, and this also brings Microsoft.Extensions.Http
         transitively, so no new Directory.Packages.props entry is needed for this project. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VSaga.Abstractions\VSaga.Abstractions.csproj" />
    <ProjectReference Include="..\VSaga.Transport.Common\VSaga.Transport.Common.csproj" />
  </ItemGroup>

</Project>
