<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <!-- Not used at runtime — the `dotnet ef migrations` tooling requires its startup project to
         directly reference this package (a transitive reference from BugsMQ.Persistence.EFCore isn't
         enough, since that project marks it PrivateAssets="all"). PrivateAssets="all" here too so it
         doesn't ship in the published output. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BugsMQ.Observability\BugsMQ.Observability.csproj" />
    <!-- Brings in BugsMQ.Persistence.EFCore transitively; referenced directly (rather than the plain
         BugsMQ.Persistence.EFCore project) so the Npgsql-specific EF Core migrations assembly is
         present in this app's output for MigrationsAssembly(...)/MigrateAsync() to find at runtime. -->
    <ProjectReference Include="..\BugsMQ.Persistence.EFCore.Postgres\BugsMQ.Persistence.EFCore.Postgres.csproj" />
    <ProjectReference Include="..\BugsMQ.Transport.RabbitMQ\BugsMQ.Transport.RabbitMQ.csproj" />
  </ItemGroup>

</Project>
